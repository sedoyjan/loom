{
  "name": "@loom-mvvm/react",
  "version": "0.1.0",
  "description": "React and React Native binding for the Loom core runtime",
  "license": "MIT",
  "author": "sedoyjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedoyjan/loom.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/sedoyjan/loom#readme",
  "bugs": {
    "url": "https://github.com/sedoyjan/loom/issues"
  },
  "keywords": [
    "loom",
    "react",
    "mvvm",
    "viewmodel"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-license.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "peerDependencies": {
    "@loom-mvvm/core": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@loom-mvvm/core": "workspace:*",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.5.1",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}

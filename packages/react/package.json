{
  "name": "@loom/react",
  "version": "0.0.0",
  "description": "React and React Native binding for the Loom core runtime",
  "license": "MIT",
  "author": "sedoyjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedoyjan/loom.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/sedoyjan/loom#readme",
  "bugs": {
    "url": "https://github.com/sedoyjan/loom/issues"
  },
  "keywords": [
    "loom",
    "react",
    "mvvm",
    "viewmodel"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-license.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "peerDependencies": {
    "@loom/core": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@loom/core": "workspace:*",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.4.0",
    "vite": "6.3.3",
    "vitest": "3.1.2"
  }
}

{
  "name": "@loom/rxjs",
  "version": "0.0.0",
  "description": "Adapter for RxJS observables as Loom reactive sources",
  "license": "MIT",
  "author": "sedoyjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedoyjan/loom.git",
    "directory": "packages/rxjs"
  },
  "homepage": "https://github.com/sedoyjan/loom#readme",
  "bugs": {
    "url": "https://github.com/sedoyjan/loom/issues"
  },
  "keywords": [
    "loom",
    "rxjs",
    "adapter"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-license.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "peerDependencies": {
    "@loom/core": "workspace:*",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@loom/core": "workspace:*",
    "rxjs": "7.8.2",
    "tsup": "8.4.0"
  }
}

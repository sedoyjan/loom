{
  "name": "loom",
  "private": true,
  "type": "module",
  "description": "Loom MVVM framework monorepo",
  "license": "MIT",
  "author": "sedoyjan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedoyjan/loom.git"
  },
  "engines": {
    "node": ">=22.14"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:demo": "pnpm build:packages && turbo run dev --parallel --filter=demo-web --filter='@loom-mvvm/*'",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:demo": "pnpm --filter demo-web build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node ./scripts/clean.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:packages",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "publish:packages": "node ./scripts/publish-packages.mjs",
    "release": "pnpm check && pnpm publish:packages",
    "release:dry-run": "node ./scripts/verify-release.mjs",
    "validate:packages": "node ./scripts/validate-packages.mjs",
    "check:placeholders": "node ./scripts/check-placeholders.mjs",
    "demo": "pnpm dev:demo",
    "demo:preview": "pnpm --filter demo-web preview"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
